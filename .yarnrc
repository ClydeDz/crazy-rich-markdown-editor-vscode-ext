# Yarn reads the registry from here, and not from ~/.npmrc, so yarn.lock always names the public registry.
# A lockfile with the address of a private mirror would not work on a GitHub runner.
# To install through a mirror once, run: yarn install --registry <address>
registry "https://registry.yarnpkg.com"

# VS Code extensions have an "engines.vscode" field. Yarn 1 reads it as an unknown engine and warns on every install.
ignore-engines true
